# Inactive template. Move to .github/workflows only after controller approval.
# This builds locally on an ephemeral runner; it does not publish or deploy.
name: Browser image preparation
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  verify-image:
    environment: browser-review
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - run: node --test apps/planner-browser/test/*.test.cjs
      - run: node apps/planner-browser/deploy/verify-container.cjs
      # A future approved release must record the accepted full SHA and image digest,
      # transfer that exact image offline or via same-region registry, check health,
      # then retain and restore the previous digest on failure.
